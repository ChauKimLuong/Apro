# Khi REST Client hỏi mật khẩu, nhập SEED_USER_PASSWORD từ backend/.env.
@baseUrl = http://localhost:3002
@newTestPassword = apro-dev-new-2026!
# Đổi registerTag trước khi chạy lại nhóm ca đăng ký trên cùng database.
@registerTag = 001
@registerTestPassword = apro-register-2026!

### Tài khoản ACTIVE, mật khẩu đúng - 200
# @prompt password Nhập SEED_USER_PASSWORD từ backend/.env
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ACTIVE@example.test",
  "password": "{{password}}"
}

### Đăng xuất phiên vừa login - 204
# Chạy sau ca login ACTIVE đúng mật khẩu. Có thể giữ giá trị apro_session để chạy ca dùng lại token cũ bên dưới.
POST {{baseUrl}}/auth/logout

### Xem tài khoản sau đăng xuất - 401 INVALID_SESSION
GET {{baseUrl}}/auth/me

### Dùng lại token cũ đã thu hồi - 401 INVALID_SESSION
# @no-cookie-jar
# @prompt password Dán giá trị token cũ, chỉ phần sau apro_session=
GET {{baseUrl}}/auth/me
Cookie: apro_session={{password}}

### Đăng xuất lần nữa khi thiếu cookie - 204
# @no-cookie-jar
POST {{baseUrl}}/auth/logout

### Tài khoản ACTIVE, mật khẩu sai - 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "active@example.test",
  "password": "intentionally-wrong-for-test"
}

### Tài khoản LOCKED, mật khẩu đúng - 403
# @prompt password Nhập SEED_USER_PASSWORD từ backend/.env
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "locked@example.test",
  "password": "{{password}}"
}

### Tài khoản LOCKED, mật khẩu sai - 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "locked@example.test",
  "password": "intentionally-wrong-for-test"
}

### Email sai định dạng - 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "validation-test-password"
}

### Thiếu mật khẩu - 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "active@example.test"
}

### Mật khẩu là số - 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "active@example.test",
  "password": 123
}

### Xem tài khoản hiện tại bằng cookie phiên - 200
# Chạy sau ca đăng nhập ACTIVE đúng mật khẩu. REST Client gửi lại cookie đã lưu.
GET {{baseUrl}}/auth/me

### Xem tài khoản hiện tại khi thiếu cookie - 401 INVALID_SESSION
# @no-cookie-jar
GET {{baseUrl}}/auth/me

### Xem tài khoản hiện tại với token không tồn tại - 401 INVALID_SESSION
# @no-cookie-jar
GET {{baseUrl}}/auth/me
Cookie: apro_session=token-khong-ton-tai

### Đổi mật khẩu khi thiếu cookie - 401 INVALID_SESSION
# @no-cookie-jar
POST {{baseUrl}}/auth/password
Content-Type: application/json

{
  "currentPassword": "unused-test-password",
  "newPassword": "{{newTestPassword}}"
}

### Đổi mật khẩu với mật khẩu hiện tại sai - 400 INVALID_CURRENT_PASSWORD
POST {{baseUrl}}/auth/password
Content-Type: application/json

{
  "currentPassword": "intentionally-wrong-for-test",
  "newPassword": "{{newTestPassword}}"
}

### Mật khẩu mới là số - 400 VALIDATION_ERROR
POST {{baseUrl}}/auth/password
Content-Type: application/json

{
  "currentPassword": "unused-test-password",
  "newPassword": 123
}

### Đổi mật khẩu thành công - 204
# Đăng nhập ACTIVE hai lần trước khi đổi và giữ giá trị apro_session của lần đầu.
# @prompt password Nhập mật khẩu hiện tại của tài khoản ACTIVE
POST {{baseUrl}}/auth/password
Content-Type: application/json

{
  "currentPassword": "{{password}}",
  "newPassword": "{{newTestPassword}}"
}

### Kiểm tra phiên cũ sau khi đổi mật khẩu - 401 INVALID_SESSION
# @no-cookie-jar
# @prompt password Dán giá trị apro_session của lần login đầu tiên
GET {{baseUrl}}/auth/me
Cookie: apro_session={{password}}

### Đăng nhập bằng mật khẩu cũ sau khi đổi - 401 INVALID_CREDENTIALS
# @no-cookie-jar
# @prompt password Nhập mật khẩu trước khi đổi của tài khoản ACTIVE
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "active@example.test",
  "password": "{{password}}"
}

### Đăng nhập bằng mật khẩu mới - 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "active@example.test",
  "password": "{{newTestPassword}}"
}

### Đăng ký tài khoản mới - 201
# @no-cookie-jar
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "  Nguyễn Văn Test  ",
  "email": " Register+{{registerTag}}@example.test ",
  "password": "{{registerTestPassword}}"
}

### Đăng ký trùng email với cách viết khác - 409 EMAIL_ALREADY_EXISTS
# @no-cookie-jar
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Nguyễn Văn Test",
  "email": "register+{{registerTag}}@EXAMPLE.TEST",
  "password": "{{registerTestPassword}}"
}

### Gửi trạng thái ACTIVE khi đăng ký - 400 VALIDATION_ERROR
# @no-cookie-jar
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Nguyễn Văn Test",
  "email": "status-test@example.test",
  "password": "{{registerTestPassword}}",
  "status": "ACTIVE"
}

### Đăng nhập bằng tài khoản vừa đăng ký - 401 INVALID_CREDENTIALS
# @no-cookie-jar
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "register+{{registerTag}}@example.test",
  "password": "{{registerTestPassword}}"
}
