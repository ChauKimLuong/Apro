# Nhập mật khẩu hiện tại của tài khoản test. Mặc định ban đầu là SEED_USER_PASSWORD trong backend/.env.
@baseUrl = http://localhost:3002

### Tài khoản ACTIVE, mật khẩu đúng - 200
# @prompt password Nhập SEED_USER_PASSWORD từ backend/.env
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ACTIVE@example.test",
  "password": "{{password}}"
}

### Tài khoản ACTIVE, mật khẩu sai - 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "active@example.test",
  "password": "intentionally-wrong-for-test"
}

### Tài khoản LOCKED, mật khẩu đúng - 403
# @prompt password Nhập SEED_USER_PASSWORD từ backend/.env
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "locked@example.test",
  "password": "{{password}}"
}

### Tài khoản LOCKED, mật khẩu sai - 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "locked@example.test",
  "password": "intentionally-wrong-for-test"
}

### Email sai định dạng - 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "validation-test-password"
}

### Thiếu mật khẩu - 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "active@example.test"
}

### Mật khẩu là số - 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "active@example.test",
  "password": 123
}
