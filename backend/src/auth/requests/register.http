# Cấp tài khoản mới bằng POST /users. Xem ../../users/requests/create-employee.http.
@baseUrl = http://localhost:3003
@registerTestEmail = self-registration-disabled@example.test
@registerTestPassword = apro-register-2026!

### Luồng tự đăng ký đã đóng - 404
# @no-cookie-jar
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Nhân viên thử tự đăng ký",
  "email": "{{registerTestEmail}}",
  "password": "{{registerTestPassword}}"
}

### Email từ yêu cầu tự đăng ký không đăng nhập được - 401 INVALID_CREDENTIALS
# @no-cookie-jar
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{registerTestEmail}}",
  "password": "{{registerTestPassword}}"
}
