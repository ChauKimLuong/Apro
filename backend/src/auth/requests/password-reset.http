# Gửi mã tới tài khoản ACTIVE rồi xem email trong Mailpit tại http://127.0.0.1:8025.
@baseUrl = http://localhost:3002

### Yêu cầu OTP cho tài khoản ACTIVE - 202
# @no-cookie-jar
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": " active@example.test "
}

### Yêu cầu OTP cho email không tồn tại - 202
# @no-cookie-jar
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "unknown-reset-test@example.test"
}

### Nhập OTP và đặt mật khẩu mới - 200 PASSWORD_RESET_SUCCESS
# Dùng mã của lần gửi gần nhất. Giữ mã lại để chạy ca dùng lại OTP bên dưới.
# @no-cookie-jar
# @prompt otp Nhập 6 chữ số từ thư Mailpit mới nhất
# @prompt password Nhập mật khẩu mới có ít nhất 12 ký tự
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "email": "active@example.test",
  "otp": "{{otp}}",
  "newPassword": "{{password}}"
}

### Dùng lại OTP đã sử dụng - 400 INVALID_RESET_CODE
# @no-cookie-jar
# @prompt otp Nhập lại OTP đã dùng ở ca thành công
# @prompt password Nhập mật khẩu mới có ít nhất 12 ký tự
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "email": "active@example.test",
  "otp": "{{otp}}",
  "newPassword": "{{password}}"
}

### Đăng nhập bằng mật khẩu vừa đặt lại - 200
# Chạy sau khi request đặt lại mật khẩu trả 200 PASSWORD_RESET_SUCCESS.
# @no-cookie-jar
# @prompt password Nhập lại mật khẩu mới vừa đặt
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "active@example.test",
  "password": "{{password}}"
}
