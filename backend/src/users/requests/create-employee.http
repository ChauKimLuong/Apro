@baseUrl = http://localhost:3003
@chiAssignmentId = 20000000-0000-4000-8000-000000000106
@anAssignmentId = 20000000-0000-4000-8000-000000000101
@unitId = 30000000-0000-4000-8000-000000000102
@positionId = 40000000-0000-4000-8000-000000000106
# Chạy tuần tự với seed Công ty A và Mailpit local.

### Gửi yêu cầu cấp tài khoản khi chưa đăng nhập - 401 INVALID_SESSION
# @no-cookie-jar
POST {{baseUrl}}/users
Content-Type: application/json

{
  "fullName": "Nhân viên kiểm thử cấp nội bộ",
  "email": "nhan-vien-001@example.test",
  "organizationalUnitId": "{{unitId}}",
  "positionId": "{{positionId}}"
}

### Đăng nhập Chi - 200
# @prompt chiPassword Nhập mật khẩu của chi@example.test
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "chi@example.test",
  "password": "{{chiPassword}}"
}

### Chi gửi yêu cầu cấp tài khoản - 403 MISSING_PERMISSION
POST {{baseUrl}}/users
X-Employee-Assignment-Id: {{chiAssignmentId}}
Content-Type: application/json

{
  "fullName": "Nhân viên kiểm thử cấp nội bộ",
  "email": "nhan-vien-001@example.test",
  "organizationalUnitId": "{{unitId}}",
  "positionId": "{{positionId}}"
}

### Đăng xuất Chi - 200
POST {{baseUrl}}/auth/logout

### Đăng nhập An - 200
# @prompt anPassword Nhập mật khẩu của an@example.test
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "an@example.test",
  "password": "{{anPassword}}"
}

### An xem đơn vị và chức danh đang hoạt động - 200
GET {{baseUrl}}/users/provisioning-options
X-Employee-Assignment-Id: {{anAssignmentId}}

### An cấp tài khoản - 201 EMPLOYEE_ACCOUNT_CREATED
# emailDelivery = SENT khi SMTP nhận thư chào mừng.
# Kiểm tra thư “Tài khoản Apro của bạn đã được cấp” tại http://127.0.0.1:8025.
# Lần chạy thứ hai với cùng email trả 409 EMAIL_ALREADY_EXISTS.
# @prompt employeeEmail Nhập email nhân viên thử chưa có trong cơ sở dữ liệu
POST {{baseUrl}}/users
X-Employee-Assignment-Id: {{anAssignmentId}}
Content-Type: application/json

{
  "fullName": "Nhân viên kiểm thử cấp nội bộ",
  "email": "{{employeeEmail}}",
  "organizationalUnitId": "{{unitId}}",
  "positionId": "{{positionId}}"
}

### Đăng xuất phiên đang test - 200
POST {{baseUrl}}/auth/logout
