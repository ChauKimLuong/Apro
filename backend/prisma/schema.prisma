// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@map("user_status")
}

enum OrganizationalUnitType {
  COMPANY
  DIVISION
  DEPARTMENT
  TEAM

  @@map("organizational_unit_type")
}

enum OrganizationalUnitStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@map("organizational_unit_status")
}

enum PositionType {
  STAFF
  LEADER
  MANAGER
  EXECUTIVE

  @@map("position_type")
}

enum PositionStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@map("position_status")
}

enum AssignmentType {
  OFFICIAL
  CONCURRENT
  TEMPORARY

  @@map("assignment_type")
}

enum PermissionCode {
  USER_VIEW
  USER_CREATE
  USER_UPDATE
  ORGANIZATION_VIEW
  ORGANIZATION_MANAGE
  ROLE_ASSIGN
  FORM_VIEW
  FORM_CREATE
  FORM_UPDATE
  FORM_REVIEW
  WORKFLOW_VIEW
  WORKFLOW_UPDATE
  WORKFLOW_MANAGE
  REQUEST_CREATE
  REQUEST_VIEW
  REQUEST_SUBMIT
  REQUEST_CANCEL
  REQUEST_APPROVE
  REQUEST_REJECT
  AUDIT_LOG_VIEW

  @@map("permission_code")
}

enum SystemRoleCode {
  SYSTEM_ADMIN
  WORKFLOW_MANAGER
  REQUESTER
  APPROVER
  AUDITOR

  @@map("system_role_code")
}

enum RoleScopeType {
  GLOBAL
  ORGANIZATIONAL_UNIT

  @@map("role_scope_type")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String     @map("full_name")
  email        String     @unique(map: "ux_users_email")
  status       UserStatus @default(ACTIVE)
  passwordHash String     @map("password_hash")

  sessions          AuthSession[]
  passwordResetCode PasswordResetCode?
  assignments       EmployeeAssignment[]

  @@map("users")
}

model AuthSession {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model PasswordResetCode {
  userId         String    @id @map("user_id") @db.Uuid
  codeHash       String    @map("code_hash")
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  failedAttempts Int       @default(0) @map("failed_attempts")
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

model OrganizationalUnit {
  id       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  type     OrganizationalUnitType
  status   OrganizationalUnitStatus @default(ACTIVE)
  parentId String?                  @map("parent_id") @db.Uuid

  parent      OrganizationalUnit?  @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_units_parent")
  children    OrganizationalUnit[] @relation("UnitHierarchy")
  assignments EmployeeAssignment[]

  @@map("organizational_units")
}

model Position {
  id     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  type   PositionType
  status PositionStatus @default(ACTIVE)

  assignments EmployeeAssignment[]

  @@map("positions")
}

model EmployeeAssignment {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String         @map("user_id") @db.Uuid
  organizationalUnitId String         @map("organizational_unit_id") @db.Uuid
  positionId           String         @map("position_id") @db.Uuid
  managerAssignmentId  String?        @map("manager_assignment_id") @db.Uuid
  type                 AssignmentType
  isPrimary            Boolean        @default(false) @map("is_primary")
  startedAt            DateTime       @map("started_at") @db.Timestamptz(6)
  endedAt              DateTime?      @map("ended_at") @db.Timestamptz(6)

  user               User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignments_user")
  organizationalUnit OrganizationalUnit   @relation(fields: [organizationalUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignments_unit")
  position           Position             @relation(fields: [positionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignments_position")
  manager            EmployeeAssignment?  @relation("AssignmentManagement", fields: [managerAssignmentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignments_manager")
  directReports      EmployeeAssignment[] @relation("AssignmentManagement")
  roleAssignments    RoleAssignment[]

  @@unique([id, userId])
  @@index([userId], map: "ix_assignments_user")
  @@index([positionId], map: "ix_assignments_position")
  @@map("employee_assignments")
}

model Permission {
  id   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code PermissionCode @unique
  name String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model SystemRole {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  code        SystemRoleCode @unique
  isActive    Boolean        @default(true) @map("is_active")

  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@map("system_roles")
}

model RoleAssignment {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeAssignmentId String        @map("employee_assignment_id") @db.Uuid
  systemRoleId         String        @map("system_role_id") @db.Uuid
  scopeType            RoleScopeType @map("scope_type")
  validFrom            DateTime      @map("valid_from") @db.Timestamptz(6)
  validUntil           DateTime?     @map("valid_until") @db.Timestamptz(6)
  revokedAt            DateTime?     @map("revoked_at") @db.Timestamptz(6)

  employeeAssignment EmployeeAssignment @relation(fields: [employeeAssignmentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_assignments_employee")
  systemRole         SystemRole         @relation(fields: [systemRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_assignments_role")

  @@index([employeeAssignmentId], map: "ix_role_assignments_employee")
  @@index([systemRoleId], map: "ix_role_assignments_role")
  @@map("role_assignments")
}

model RolePermission {
  systemRoleId String @map("system_role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  systemRole SystemRole @relation(fields: [systemRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permissions_role")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permissions_permission")

  @@id([systemRoleId, permissionId])
  @@map("role_permissions")
}
